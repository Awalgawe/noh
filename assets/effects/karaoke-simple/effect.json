{
  "engine": 1,
  "id": "noh.karaoke-simple",
  "name": {"fr": "Karaoké sobre", "en": "Simple karaoke", "de": "Schlichtes Karaoke", "es": "Karaoke sobrio", "ja": "シンプルカラオケ", "ko": "심플 노래방", "zh": "简洁卡拉OK"},
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "target": "text",
  "params": [
    {"id": "sung", "type": "color", "default": "#FFD34D", "level": 1, "label": {"fr": "Couleur chantée", "en": "Sung colour", "de": "Gesungene Farbe", "es": "Color cantado", "ja": "歌った部分の色", "ko": "부른 부분 색", "zh": "已唱颜色"}},
    {"id": "size", "type": "choice", "default": "medium", "choices": ["small", "medium", "large"], "choice_labels": {"small": {"fr": "Petite", "en": "Small", "de": "Klein", "es": "Pequeño", "ja": "小", "ko": "작게", "zh": "小"}, "medium": {"fr": "Moyenne", "en": "Medium", "de": "Mittel", "es": "Mediano", "ja": "中", "ko": "보통", "zh": "中"}, "large": {"fr": "Grande", "en": "Large", "de": "Groß", "es": "Grande", "ja": "大", "ko": "크게", "zh": "大"}}, "level": 1, "label": {"fr": "Taille", "en": "Size", "de": "Größe", "es": "Tamaño", "ja": "サイズ", "ko": "크기", "zh": "大小"}},
    {"id": "placement", "type": "choice", "default": "bottom", "choices": ["bottom", "top"], "choice_labels": {"bottom": {"fr": "En bas", "en": "Bottom", "de": "Unten", "es": "Abajo", "ja": "下", "ko": "아래", "zh": "底部"}, "top": {"fr": "En haut", "en": "Top", "de": "Oben", "es": "Arriba", "ja": "上", "ko": "위", "zh": "顶部"}}, "level": 1, "label": {"fr": "Position", "en": "Position", "de": "Position", "es": "Posición", "ja": "位置", "ko": "위치", "zh": "位置"}},
    {"id": "font", "type": "font", "default": "inter_semibold", "level": 2, "label": {"fr": "Police", "en": "Font", "de": "Schrift", "es": "Fuente", "ja": "フォント", "ko": "글꼴", "zh": "字体"}}
  ],
  "presets": [
    {"id": "gold", "name": {"fr": "Doré", "en": "Gold", "de": "Gold", "es": "Dorado", "ja": "ゴールド", "ko": "골드", "zh": "金色"}, "values": {}}
  ],
  "layout": {
    "mode": "line",
    "font": "$font",
    "size": {"by_offset": [{"mul": [{"min": ["@short", {"sub": [{"sub": ["@w", "@inset_l"]}, "@inset_r"]}]}, {"choose": ["$size", {"small": 0.07553, "medium": 0.09211, "large": 0.11053}]}]}, {"mul": [{"min": ["@short", {"sub": [{"sub": ["@w", "@inset_l"]}, "@inset_r"]}]}, {"choose": ["$size", {"small": 0.06204, "medium": 0.07566, "large": 0.09079}]}]}]},
    "line_height": 1.3,
    "box": {
      "x": 0.5,
      "width": 0.88,
      "y": {"choose": ["$placement", {"bottom": {"sub": [0.84, {"div": [{"mul": [{"min": ["@short", {"sub": [{"sub": ["@w", "@inset_l"]}, "@inset_r"]}]}, {"choose": ["$size", {"small": 0.08065, "medium": 0.09836, "large": 0.11803}]}]}, "@h"]}]}, "top": 0.16}]},
      "anchor": {"choose": ["$placement", {"bottom": "bottom", "top": "top"}]}
    },
    "visible": "line",
    "anchor": "unit",
    "window": {"after": 1, "lead": 10, "gap": 0},
    "word_lead": 0.08,
    "hold": 3
  },
  "animate": [
    {"unit": "word", "slot": "enter", "property": "color", "duration": 0.12, "keys": [[0, "#FFFFFF"], [1, "$sung"]]}
  ],
  "render": {
    "passes": [
      {"kind": "fill", "color": "#FFFFFF", "alpha": {"by_offset": [1, 0.45]}}
    ]
  }
}
