{
  "engine": 1,
  "id": "noh.pop-blur",
  "name": {"fr": "Pop flou", "en": "Blur pop"},
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "target": "text",
  "params": [
    {"id": "color", "type": "color", "default": "#FFFFFF", "level": 1, "label": {"fr": "Couleur"}},
    {"id": "size", "type": "number", "default": {"landscape": 92, "portrait": 104}, "min": 24, "max": 200, "unit": "px", "level": 1, "label": {"fr": "Taille"}},
    {"id": "blur", "type": "number", "default": 14, "min": 0, "max": 40, "unit": "px", "level": 1, "label": {"fr": "Flou d'entrée"}},
    {"id": "pop", "type": "number", "default": 0.55, "min": 0.1, "max": 1, "level": 2, "label": {"fr": "Échelle de départ"}}
  ],
  "presets": [
    {"id": "blanc", "name": {"fr": "Blanc"}, "values": {}},
    {"id": "doux", "name": {"fr": "Doux"}, "values": {"blur": 6, "pop": 0.8}}
  ],
  "layout": {
    "mode": "line",
    "font": "jost_extrabold",
    "size": "$size",
    "case": "upper",
    "line_height": 1.18,
    "box": {"x": 0.5, "y": {"landscape": 0.88, "portrait": 0.62}, "width": 0.86, "anchor": {"landscape": "bottom", "portrait": "center"}},
    "raster": 1.25,
    "visible": "from_start",
    "anchor": "word_x_glyph_y"
  },
  "animate": [
    {"unit": "line", "slot": "enter", "property": "opacity", "duration": 0.15, "keys": [[0, 0], [1, 1]]},
    {"unit": "line", "slot": "exit", "property": "opacity", "duration": 0.12, "keys": [[0, 1], [1, 0]]},
    {"unit": "word", "slot": "enter", "property": "scale", "duration": 0.30, "curve": "back", "keys": [[0, "$pop"], [1, 1]]},
    {"unit": "word", "slot": "enter", "property": "scale_x", "duration": 0.18, "keys": [[0, 1.35], [1, 1]]},
    {"unit": "word", "slot": "enter", "property": "opacity", "duration": 0.12, "keys": [[0, 0], [1, 1]]},
    {"unit": "word", "slot": "enter", "property": "blur", "duration": 0.22, "keys": [[0, "$blur"], [1, 0]]}
  ],
  "render": {
    "passes": [
      {"kind": "shadow", "color": "#000000", "alpha": 0.55, "offset_y": 0.06, "blur": 3},
      {"kind": "fill", "color": "$color"}
    ]
  }
}
