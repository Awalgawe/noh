{
  "engine": 1,
  "id": "test.window",
  "name": {
    "en": "Test window"
  },
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "target": "text",
  "params": [
    {
      "id": "sung",
      "type": "color",
      "default": "#FFD400",
      "level": 1,
      "label": {
        "en": "Sung colour"
      }
    },
    {
      "id": "rest",
      "type": "color",
      "default": "#FFFFFF",
      "level": 1,
      "label": {
        "en": "Text colour"
      }
    },
    {
      "id": "size",
      "type": "number",
      "default": {
        "landscape": 64,
        "portrait": 76
      },
      "min": 24,
      "max": 160,
      "unit": "px",
      "level": 1,
      "label": {
        "en": "Size"
      }
    },
    {
      "id": "shadow",
      "type": "number",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "level": 2,
      "label": {
        "en": "Shadow"
      }
    }
  ],
  "presets": [
    {
      "id": "jaune",
      "name": {
        "en": "Yellow"
      },
      "values": {}
    },
    {
      "id": "rose",
      "name": {
        "en": "Pink"
      },
      "values": {
        "sung": "#FF4F8B"
      }
    }
  ],
  "layout": {
    "mode": "line",
    "font": "sans_semibold",
    "size": {
      "by_offset": [
        "$size",
        {
          "mul": [
            "$size",
            0.7
          ]
        }
      ]
    },
    "line_height": 1.18,
    "box": {
      "x": 0.5,
      "y": {
        "landscape": 0.8,
        "portrait": 0.58
      },
      "width": 0.86,
      "anchor": {
        "landscape": "bottom",
        "portrait": "center"
      }
    },
    "visible": "line",
    "anchor": "unit",
    "window": {
      "after": 1,
      "lead": 2.5,
      "gap": 0.3
    }
  },
  "animate": [
    {
      "unit": "line",
      "slot": "enter",
      "property": "opacity",
      "duration": 0.15,
      "keys": [
        [
          0,
          0
        ],
        [
          1,
          1
        ]
      ]
    },
    {
      "unit": "line",
      "slot": "exit",
      "property": "opacity",
      "duration": 0.12,
      "keys": [
        [
          0,
          1
        ],
        [
          1,
          0
        ]
      ]
    },
    {
      "unit": "syllable",
      "slot": "active",
      "property": "wipe",
      "keys": [
        [
          0,
          0
        ],
        [
          1,
          1
        ]
      ]
    },
    {
      "unit": "syllable",
      "slot": "past",
      "property": "wipe",
      "value": 1
    }
  ],
  "render": {
    "passes": [
      {
        "kind": "shadow",
        "color": "#000000",
        "alpha": {
          "by_state": {
            "active": "$shadow",
            "next": {
              "mul": [
                "$shadow",
                0.55
              ]
            },
            "past": {
              "mul": [
                "$shadow",
                0.55
              ]
            }
          }
        },
        "offset_y": 0.05,
        "blur": 3
      },
      {
        "kind": "fill",
        "color": "$rest",
        "color2": "$sung",
        "alpha": {
          "by_state": {
            "active": 1,
            "next": 0.55,
            "past": 0.55
          }
        }
      }
    ]
  }
}
