// The heaviest layer shader of its kind (vector) that the validator accepts.
// Generated by the motion prototype (gen_worst_shader.py).
fn mixv(p: vec4<f32>, t: f32) -> vec4<f32> {
  let m = mat4x4<f32>(sin(p + t), cos(p.yzwx - t), p.zwxy * 0.7, fract(p * 3.1));
  let a = m * p;
  let b = m * m;
  let c = b * a + sin(a * 1.7 + t) * cos(a.wzyx * 2.3);
  let e = exp(-abs(c)) + sqrt(abs(a - c) + 0.01);
  return fract(e * 43758.5453 + a * c);
}
