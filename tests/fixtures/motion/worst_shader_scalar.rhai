// noh-motion 0
// The worst legal frame of layer shaders, scalar kind: one layer at full
// resolution and two at half (1.5 frames of pixels, the cap), each running
// the heaviest scalar shader over a line of text. Generated by
// the motion prototype (gen_worst_shader.py).
fn frame(t, ctx) {
    for k in 0..3 {
        let l = layer().shader("heavy").resolution(pick(k, "full", "half", "half")).param(0, k.to_float());
        l.add(text("heavy").size(0.2).at(0.5, 0.2 + 0.3 * k.to_float()));
        draw(l.opacity(0.5));
    }
}
