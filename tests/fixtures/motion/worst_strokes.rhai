// noh-motion 0
// The heaviest strokes, as literals: 4 waves of four strongly bent curves
// (64 segments each, 1024 in all, the cap), 0.05 wide with round caps, their
// trim moving every frame. Generated by examples/gen_worst_shapes.py.
fn frame(t, ctx) {
    draw(path().move_to(0.05000, 0.10000)
        .cubic_to(0.06740, 0.32222, 0.08479, -0.12222, 0.10219, 0.10000)
        .cubic_to(0.11959, 0.32222, 0.13699, -0.12222, 0.15438, 0.10000)
        .cubic_to(0.17178, 0.32222, 0.18918, -0.12222, 0.20658, 0.10000)
        .cubic_to(0.22397, 0.32222, 0.24137, -0.12222, 0.25877, 0.10000)
        .stroke("#F2E8D8", 0.05).caps("round").trim(0.0, 0.75 + 0.25 * sin(t * 2.0 + 0.0)).opacity(0.7));
    draw(path().move_to(0.37000, 0.10000)
        .cubic_to(0.38740, 0.32222, 0.40479, -0.12222, 0.42219, 0.10000)
        .cubic_to(0.43959, 0.32222, 0.45699, -0.12222, 0.47438, 0.10000)
        .cubic_to(0.49178, 0.32222, 0.50918, -0.12222, 0.52658, 0.10000)
        .cubic_to(0.54397, 0.32222, 0.56137, -0.12222, 0.57877, 0.10000)
        .stroke("#F2E8D8", 0.05).caps("round").trim(0.0, 0.75 + 0.25 * sin(t * 2.0 + 1.0)).opacity(0.7));
    draw(path().move_to(0.69000, 0.10000)
        .cubic_to(0.70740, 0.32222, 0.72479, -0.12222, 0.74219, 0.10000)
        .cubic_to(0.75959, 0.32222, 0.77699, -0.12222, 0.79438, 0.10000)
        .cubic_to(0.81178, 0.32222, 0.82918, -0.12222, 0.84658, 0.10000)
        .cubic_to(0.86397, 0.32222, 0.88137, -0.12222, 0.89877, 0.10000)
        .stroke("#F2E8D8", 0.05).caps("round").trim(0.0, 0.75 + 0.25 * sin(t * 2.0 + 2.0)).opacity(0.7));
    draw(path().move_to(0.05000, 0.35000)
        .cubic_to(0.06740, 0.57222, 0.08479, 0.12778, 0.10219, 0.35000)
        .cubic_to(0.11959, 0.57222, 0.13699, 0.12778, 0.15438, 0.35000)
        .cubic_to(0.17178, 0.57222, 0.18918, 0.12778, 0.20658, 0.35000)
        .cubic_to(0.22397, 0.57222, 0.24137, 0.12778, 0.25877, 0.35000)
        .stroke("#F2E8D8", 0.05).caps("round").trim(0.0, 0.75 + 0.25 * sin(t * 2.0 + 3.0)).opacity(0.7));
}
