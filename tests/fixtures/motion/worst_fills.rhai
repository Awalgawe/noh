// noh-motion 0
// The heaviest fills, as literals (an author can write coordinates by hand,
// about 7 operations a curve): 4 wavy blobs of 128 points each once
// flattened (512 filled points, the cap), turning, so cut again every frame;
// every other one with an eight-stop radial gradient. Generated by examples/gen_worst_shapes.py.
fn frame(t, ctx) {
    let p0 = path().move_to(0.29395, 0.30000)
        .cubic_to(0.28873, 0.57264, 0.19478, 0.31604, 0.10605, 0.30000)
        .cubic_to(0.11127, 0.02736, 0.20522, 0.28396, 0.29395, 0.30000)
        .close().pivot(0.20000, 0.30000).rot(t * 0.20000);
    p0.fill("#C8102E");
    draw(p0.opacity(0.8));
    let p1 = path().move_to(0.59395, 0.30000)
        .cubic_to(0.58873, 0.57264, 0.49478, 0.31604, 0.40605, 0.30000)
        .cubic_to(0.41127, 0.02736, 0.50522, 0.28396, 0.59395, 0.30000)
        .close().pivot(0.50000, 0.30000).rot(t * 0.23000);
    p1.radial(0.50000, 0.30000, 0.4).stop(0.0, "#FFFFFF", 1.0).stop(0.14, "#FFE7A0", 1.0).stop(0.28, "#F0A030", 0.9).stop(0.42, "#C8102E", 0.8).stop(0.56, "#7A0A1E", 0.7).stop(0.7, "#301018", 0.6).stop(0.85, "#101828", 0.5).stop(1.0, "#000000", 0.0);
    draw(p1.opacity(0.8));
    let p2 = path().move_to(0.89395, 0.30000)
        .cubic_to(0.88873, 0.57264, 0.79478, 0.31604, 0.70605, 0.30000)
        .cubic_to(0.71127, 0.02736, 0.80522, 0.28396, 0.89395, 0.30000)
        .close().pivot(0.80000, 0.30000).rot(t * 0.26000);
    p2.fill("#C8102E");
    draw(p2.opacity(0.8));
    let p3 = path().move_to(0.29395, 0.70000)
        .cubic_to(0.28873, 0.97264, 0.19478, 0.71604, 0.10605, 0.70000)
        .cubic_to(0.11127, 0.42736, 0.20522, 0.68396, 0.29395, 0.70000)
        .close().pivot(0.20000, 0.70000).rot(t * 0.29000);
    p3.radial(0.20000, 0.70000, 0.4).stop(0.0, "#FFFFFF", 1.0).stop(0.14, "#FFE7A0", 1.0).stop(0.28, "#F0A030", 0.9).stop(0.42, "#C8102E", 0.8).stop(0.56, "#7A0A1E", 0.7).stop(0.7, "#301018", 0.6).stop(0.85, "#101828", 0.5).stop(1.0, "#000000", 0.0);
    draw(p3.opacity(0.8));
}
